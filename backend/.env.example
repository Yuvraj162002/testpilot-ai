# Copy to .env (optional). .env is git-ignored — never commit it.
# claude-cli = your own Claude Code login (no API key needed). api = Anthropic API key below.
AI_PROVIDER=claude-cli
# CLAUDE_MODEL=sonnet            # claude-cli: sonnet / opus / haiku ; api: e.g. claude-sonnet-5-5
# ANTHROPIC_API_KEY=             # only for AI_PROVIDER=api
